# Optional. Defaults work without API keys for a single-process local MVP.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/
OSRM_BASE_URL=https://router.project-osrm.org
# Identify your own application; add a real contact URL/email before broader use.
GEOCODING_USER_AGENT=ReciclaMapa/2.0 (local-MVP)
# The public Nominatim service is limited to at most 1 request/second across the app,
# no autocomplete or bulk geocoding. See https://operations.osmfoundation.org/policies/nominatim/
# Production or multiple server instances require shared throttling/cache or your own providers.
